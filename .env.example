# انسخ هذا الملف إلى .env.local واملأ القيم من Supabase → Project Settings → API
# المفتاح العام (anon / publishable) فقط — لا تضع service_role key هنا أبدًا.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# اتركه فارغًا في الإنتاج. "true" يشغّل وضع المعاينة التجريبي (بيانات محلية في المتصفح فقط).
VITE_DEMO_MODE=
